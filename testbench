module testbench;

  reg clk;
  reg rst;
  reg [7:0] original_data_in; 
  reg sync_in;
  reg bypass;

  wire [7:0] scrambled_data_out; 
  wire [7:0] descrambled_data_out; 

  // Scrambler Instantiation
  data_scrambler uut_scrambler (
    .clk        (clk),
    .rst        (rst),
    .data_in    (original_data_in),
    .sync_in    (sync_in),
    .bypass     (bypass),
    .data_out   (scrambled_data_out)
  );

  // Descrambler Instantiation
  data_descrambler uut_descrambler (
    .clk               (clk),
    .rst               (rst),
    .scrambled_data_in (scrambled_data_out), 
    .sync_in           (sync_in),
    .bypass            (bypass),
    .data_out          (descrambled_data_out)
  );

  // clock 
  initial begin
    clk = 0;
    forever #5 clk = ~clk; // 10ns periyotlu saat
  end

  // Test 
  initial begin
    // initial values
    rst = 1;         // active reset
    original_data_in = 8'h00;
    sync_in = 0;
    bypass = 0;

    // waveform production 
    $dumpfile("testbench.vcd");
    $dumpvars(0, testbench);


    // dşsplays cycle 0 under reset
    #1 $display("clk cycle: %0d  ,  data_in:  %h   ,  lfsr value:  %h   ,   scrambled data_out:   %h      ,   descrambler lfsr:   %h      ,    descrambled d_out   %h",
0, original_data_in, uut_scrambler.x, scrambled_data_out, uut_descrambler.x, descrambled_data_out);

    // deassert reset
    #9 rst = 0; 

    // displays every 8 clk cycle to complete serial incoming 8-bit data_in 
    for (integer i = 1; i <= 9; i = i + 1) begin
      repeat (8) @(posedge clk);
      #1;
      $display("clk cycle: %0d  ,  data_in:  %h   ,  lfsr value:  %h   ,   scrambled data_out:   %h      ,   descrambler lfsr:   %h      ,    descrambled d_out   %h",
i*8 , original_data_in, uut_scrambler.x, scrambled_data_out, uut_descrambler.x, descrambled_data_out);
    end

 
    $stop; 
  end

endmodule
